# 复制为 .env 后按需修改（.env 已在 .gitignore 中）
APP_NAME=AI 智能问答平台
DEBUG=true

# 数据库：默认 SQLite，零配置启动。可改为 mysql+pymysql://user:pwd@host:3306/aiqa
DATABASE_URL=sqlite:///./ai_qa.db

# 安全：生产环境务必更换！
SECRET_KEY=please-change-this-secret-key-in-production-0a1b2c3d4e5f
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 前端地址（CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 默认模型（对应 model_configs 表中的 key）
DEFAULT_MODEL=qwen-plus

# 模型 Key（留空则自动回退到内置演示模型，项目依然可跑通全链路）
QWEN_API_KEY=
OPENAI_API_KEY=
CHATGLM_API_KEY=

# 初始化管理员账号
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
